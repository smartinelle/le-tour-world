# Supabase Configuration (required)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Application URL (for OAuth redirects)
APP_URL=http://localhost:8080

# NiceGUI storage/session secret. Set to a long random value outside local dev.
LE_TOUR_STORAGE_SECRET=change-me-in-production

# Optional: allow automatic BLE trainer scanning on app startup.
# LE_TOUR_ENABLE_BLE=1

# Optional: Service role key for admin operations (keep secret!)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
